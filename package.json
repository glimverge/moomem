{
  "name": "moomem",
  "version": "0.8.3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glimverge/moomem.git"
  },
  "type": "module",
  "scripts": {
    "automd": "automd",
    "commitlint": "commitlint",
    "format": "pnpm automd && rs fmt",
    "format:check": "rs fmt --check",
    "prepare": "rs hooks",
    "release": "bumpp",
    "test": "moon test"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@heyq02/rstack-config": "^0.0.5",
    "automd": "^0.4.3",
    "bumpp": "^12.3.0",
    "rstack": "^0.8.3"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  }
}
