// Local LoCoMo sample. Reads benchmark/.env. Native only: the HTTP client
// is not available on wasm / js, and CI tests those targets.
import {
  "heyq02/moomem/src",
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
}

pkgtype(kind: "executable")

options(
  targets: {
    "main.mbt": ["native"],
    "live.mbt": ["native"],
    "stub.mbt": ["wasm", "wasm-gc", "js"],
  },
)
