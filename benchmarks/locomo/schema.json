{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/glimverge/moomem/benchmarks/locomo/schema.json",
  "title": "moomem LoCoMo release result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module",
    "version",
    "git_tag",
    "committed_at",
    "fixture",
    "runs"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "module": { "type": "string" },
    "version": { "type": "string" },
    "git_tag": { "type": "string" },
    "committed_at": { "type": "string", "format": "date-time" },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "note"],
      "properties": {
        "path": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offline", "api", "live"],
      "properties": {
        "offline": { "$ref": "#/$defs/run" },
        "api": { "$ref": "#/$defs/run" },
        "live": { "$ref": "#/$defs/run" }
      }
    }
  },
  "$defs": {
    "gateStatus": {
      "type": "string",
      "enum": ["pass", "fail", "n_a", "skipped", "error"]
    },
    "runStatus": {
      "type": "string",
      "enum": ["pass", "fail", "error", "skipped"]
    },
    "target15": {
      "type": "string",
      "enum": ["met", "missed", "n_a"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hybrid_recall_at_5": { "type": ["number", "null"] },
        "hybrid_mrr_at_5": { "type": ["number", "null"] },
        "bm25_recall_at_5": { "type": ["number", "null"] },
        "bm25_mrr_at_5": { "type": ["number", "null"] },
        "vs_bm25_pct": { "type": ["number", "null"] },
        "target_15pct": { "$ref": "#/$defs/target15" },
        "near_dup_supersede_rate": { "type": ["number", "null"] },
        "near_dup_ok": { "type": ["integer", "null"] },
        "near_dup_total": { "type": ["integer", "null"] },
        "cross_user_leaks": { "type": ["integer", "null"] },
        "reopen_ok": { "type": ["integer", "null"] },
        "extraction_precision": { "type": ["number", "null"] },
        "extraction_hit": { "type": ["integer", "null"] },
        "extraction_denom": { "type": ["integer", "null"] },
        "extraction_cases_scored": { "type": ["integer", "null"] },
        "extraction_cases_total": { "type": ["integer", "null"] },
        "extraction_status": {
          "type": "string",
          "enum": ["scored", "skipped", "error"]
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isolation": { "$ref": "#/$defs/gateStatus" },
        "persistence": { "$ref": "#/$defs/gateStatus" },
        "conflict": { "$ref": "#/$defs/gateStatus" },
        "hybrid_ge_bm25": { "$ref": "#/$defs/gateStatus" },
        "target_15pct": { "$ref": "#/$defs/gateStatus" },
        "extraction_precision": { "$ref": "#/$defs/gateStatus" },
        "overall": { "$ref": "#/$defs/gateStatus" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "metrics", "gates"],
      "properties": {
        "embedder": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "dim": { "type": ["integer", "null"] },
        "extractor_model": { "type": ["string", "null"] },
        "metrics": { "$ref": "#/$defs/metrics" },
        "gates": { "$ref": "#/$defs/gates" },
        "status": { "$ref": "#/$defs/runStatus" }
      }
    }
  }
}
